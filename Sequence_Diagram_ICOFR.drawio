  <diagram name="LOGIN_SCREEN" id="2YBvvXClWsGukQMizWep">
    <mxGraphModel dx="1471" dy="2953" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nactor User\nparticipant \&quot;Frontend (UI)\&quot; as FE\nparticipant \&quot;Backend (Auth Service)\&quot; as BE\ndatabase \&quot;Database\&quot; as DB\nparticipant \&quot;SSO Provider\&quot; as SSO\n\n== NORMAL LOGIN (Username &amp; Password) ==\nUser -&gt; FE: Enter Username &amp; Password\nFE -&gt; BE: Send Login Request\n\nBE -&gt; DB: Validate Credentials\nDB --&gt; BE: User Record / Not Found\n\nalt Invalid Credentials\n    BE --&gt; FE: Login Failed\n    FE --&gt; User: Show Error\nelse Valid Credentials\n    BE -&gt; DB: Fetch Client List\n    DB --&gt; BE: Client List\n    \n    BE --&gt; FE: Login Success + Client List\n    FE --&gt; User: Show Client Dropdown\n    \n    == CLIENT SELECTION ==\n    User -&gt; FE: Select Client\n    FE -&gt; BE: Send Selected Client\n    \n    BE -&gt; DB: Validate Client Access\n    DB --&gt; BE: Access Granted / Denied\n    \n    alt Access Denied\n        BE --&gt; FE: Error (Unauthorized Client)\n        FE --&gt; User: Show Error\n    else Access Granted\n        BE --&gt; FE: Session Created (Client Context)\n        FE --&gt; User: Redirect to Dashboard\n    end\nend\n\n== SSO LOGIN FLOW ==\nUser -&gt; FE: Click SSO Login\nFE -&gt; SSO: Redirect to SSO\n\nUser -&gt; SSO: Enter Credentials\nSSO -&gt; SSO: Authenticate\n\nalt SSO Failed\n    SSO --&gt; FE: Error\n    FE --&gt; User: Show Error\nelse SSO Success\n    SSO --&gt; FE: Token\n    FE -&gt; BE: Send Token\n    \n    BE -&gt; BE: Validate Token\n    BE -&gt; DB: Fetch Client List\n    DB --&gt; BE: Client List\n    \n    BE --&gt; FE: Login Success + Client List\n    FE --&gt; User: Show Client Dropdown\n    \n    == CLIENT SELECTION ==\n    User -&gt; FE: Select Client\n    FE -&gt; BE: Send Selected Client\n    \n    BE -&gt; DB: Validate Client Access\n    DB --&gt; BE: Access Result\n    \n    alt Access Denied\n        BE --&gt; FE: Error\n        FE --&gt; User: Show Error\n    else Access Granted\n        BE --&gt; FE: Session Created\n        FE --&gt; User: Redirect to Dashboard\n    end\nend\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="t9oQjmEXTvViccQdgeOu-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="2114.14" width="1070" x="60" y="-2180" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="yeegPcnekzJr7HSEq5ya" name="POST_LOGIN">
    <mxGraphModel dx="1030" dy="527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor User\nparticipant \&quot;Frontend (UI)\&quot; as FE\nparticipant \&quot;Backend (ICoFR Service)\&quot; as BE\ndatabase \&quot;Database\&quot; as DB\n\n== DASHBOARD LOAD ==\nUser -&gt; FE: Open Application (Post Login)\nFE -&gt; BE: Request Dashboard Data\nBE -&gt; DB: Fetch Dashboard Data\nDB --&gt; BE: Dashboard Data\nBE --&gt; FE: Dashboard Response\nFE --&gt; User: Display Dashboard\n\n== NAVIGATION TO RCSA ==\nUser -&gt; FE: Click Side Nav (ICoFR)\nUser -&gt; FE: Select Submenu (RCSA)\n\nFE -&gt; BE: Request RCSA Page Data\nBE -&gt; DB: Fetch RCSA Data\nDB --&gt; BE: RCSA Data\nBE --&gt; FE: RCSA Response\nFE --&gt; User: Display RCSA Page\n\n== RCSA - MASTERS SECTION ==\nUser -&gt; FE: Open Masters Section\nFE -&gt; BE: Request Master Data\n\nBE -&gt; DB: Fetch Master Data\nDB --&gt; BE: Master Data\n\nBE --&gt; FE: Masters Response\nFE --&gt; User: Display Masters Data\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="5E89SXXJkWW0-uFzZTC6-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="835" width="598" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="4oAXM2Zig-D3-9LlXMvW" name="POST_LOGIN_PERSONA_BASED">
    <mxGraphModel dx="1030" dy="527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nactor User\nparticipant \&quot;Frontend (UI)\&quot; as FE\nparticipant \&quot;Backend (ICoFR Service)\&quot; as BE\ndatabase \&quot;Database\&quot; as DB\n\n== DASHBOARD LOAD ==\nUser -&gt; FE: Open Application (Post Login)\nFE -&gt; BE: Request Dashboard Data\nBE -&gt; DB: Fetch Dashboard Data\nDB --&gt; BE: Dashboard Data\nBE --&gt; FE: Dashboard Response\nFE --&gt; User: Display Dashboard\n\n== NAVIGATION TO RCSA ==\nUser -&gt; FE: Click Side Nav (ICoFR → RCSA)\nFE -&gt; BE: Request RCSA Access\n\nBE -&gt; DB: Fetch User Role/Persona\nDB --&gt; BE: Role/Permissions\n\nalt Unauthorized Access\n    BE --&gt; FE: Access Denied\n    FE --&gt; User: Show Unauthorized Message\nelse Authorized\n    BE --&gt; FE: Access Granted + Role Info\n    FE --&gt; User: Load RCSA Page (Role-Based View)\n\n    == LOAD RCSA DATA ==\n    FE -&gt; BE: Request RCSA Data\n    BE -&gt; DB: Fetch RCSA Data\n    DB --&gt; BE: RCSA Data\n    BE --&gt; FE: RCSA Response\n    FE --&gt; User: Display RCSA Page\n\n    == ROLE-BASED UI CONTROL ==\n    note right of FE\n      UI elements visible based on role:\n      - Admin:Complete Access\n      - CRO: Access Based on Role\n      - Risk Owner: Limited Access\n    end note\n\n    == RCSA MASTERS ==\n    User -&gt; FE: Open Masters Section\n    FE -&gt; BE: Request Master Data\n\n    BE -&gt; DB: Fetch Master Data\n    DB --&gt; BE: Master Data\n\n    BE --&gt; FE: Masters Response\n    FE --&gt; User: Display Masters (if permitted)\nend\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="awNpOSSrLU4_-lQ8OXyj-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1206" width="693" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="4Y9vRGoQ-LgXuRUJ9DV0" name="Organisation_Master">
    <mxGraphModel dx="1030" dy="527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor User\nparticipant \&quot;Frontend (UI)\&quot; as FE\nparticipant \&quot;Backend Service\&quot; as BE\ndatabase \&quot;Database\&quot; as DB\n\n== LOAD PAGE ==\nUser -&gt; FE: Open Organisation Master\nFE -&gt; BE: Request Organisation Data\nBE -&gt; DB: Fetch Organisation List\nDB --&gt; BE: Data\nBE --&gt; FE: Response\nFE --&gt; User: Display Data\n\n== ADD (MANUAL) ==\nUser -&gt; FE: Enter Organisation Details\nFE -&gt; BE: Send Create Request\nBE -&gt; DB: Insert Data\nBE --&gt; FE: Success\nFE --&gt; User: Show Success\n\n== UPLOAD ==\nUser -&gt; FE: Upload File\nFE -&gt; BE: Send File\nBE -&gt; BE: Validate File\nBE -&gt; DB: Bulk Insert\nBE --&gt; FE: Upload Result\nFE --&gt; User: Show Result\n\n== UPDATE ==\nUser -&gt; FE: Edit Organisation\nFE -&gt; BE: Send Update Request\nBE -&gt; DB: Update Record\nBE --&gt; FE: Success\n\n== DELETE ==\nUser -&gt; FE: Delete Organisation\nFE -&gt; BE: Delete Request\nBE -&gt; DB: Delete Record\nBE --&gt; FE: Success\n\n== STATUS CHANGE ==\nUser -&gt; FE: Toggle Active/Inactive\nFE -&gt; BE: Status Update Request\nBE -&gt; DB: Update Status\nBE --&gt; FE: Success\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="QFTn7WX0u6ngPHuSoFBb-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
