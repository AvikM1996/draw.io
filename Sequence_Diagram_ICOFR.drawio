  <diagram id="uMJlZerrwjMgCzfSAG7q" name="ALL_MASTERS">
    <mxGraphModel dx="1212" dy="620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nactor User\nparticipant \&quot;Frontend (UI)\&quot; as FE\nparticipant \&quot;Backend (ICoFR Service)\&quot; as BE\ndatabase \&quot;Database\&quot; as DB\n\n== OPEN MASTER MODULE ==\nUser -&gt; FE: Navigate to RCSA → Masters\nFE -&gt; BE: Request Master Access\n\nBE -&gt; DB: Fetch User Role/Permissions\nDB --&gt; BE: Role Data\n\nalt Unauthorized\n    BE --&gt; FE: Access Denied\n    FE --&gt; User: Show Error\nelse Authorized\n    BE --&gt; FE: Access Granted + Role\n    FE --&gt; User: Show Master List\n\n    == LOAD MASTER DATA ==\n    User -&gt; FE: Select Master\n    FE -&gt; BE: Request Master Data\n    BE -&gt; DB: Fetch Records\n    DB --&gt; BE: Data\n    BE --&gt; FE: Response\n    FE --&gt; User: Display Data\n\n    == CREATE (MANUAL) ==\n    User -&gt; FE: Add Record\n    FE -&gt; BE: Create Request\n    BE -&gt; DB: Insert Record\n    BE --&gt; FE: Success\n\n    == BULK UPLOAD ==\n    User -&gt; FE: Upload File\n    FE -&gt; BE: Send File\n    BE -&gt; BE: Validate File\n    \n    alt Invalid File\n        BE --&gt; FE: Upload Failed\n    else Valid File\n        BE -&gt; DB: Bulk Insert\n        BE --&gt; FE: Upload Success\n    end\n\n    == UPDATE ==\n    User -&gt; FE: Edit Record\n    FE -&gt; BE: Update Request\n    BE -&gt; DB: Update Record\n    BE --&gt; FE: Success\n\n    == DELETE (ADMIN ONLY) ==\n    User -&gt; FE: Delete Record\n    FE -&gt; BE: Delete Request\n    \n    BE -&gt; DB: Check User Role\n    DB --&gt; BE: Role\n    \n    alt User is NOT Admin\n        BE --&gt; FE: Access Denied (Delete Not Allowed)\n        FE --&gt; User: Show Permission Error\n    else User is Admin\n        BE -&gt; DB: Delete Record / Mark Inactive\n        BE --&gt; FE: Success\n        FE --&gt; User: Update UI\n    end\n\n    == STATUS MANAGEMENT ==\n    User -&gt; FE: Toggle Active/Inactive\n    FE -&gt; BE: Status Update Request\n    BE -&gt; DB: Update Status\n    BE --&gt; FE: Success\nend\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="DpFmjwRX-Z0h_FQU1Ndm-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1761" width="765" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="GfqfnGEonJ2pTZOuqTje" name="ASSESSMENT_RISK_FLOW">
    <mxGraphModel dx="1030" dy="527" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor User\nparticipant \&quot;Frontend (UI)\&quot; as FE\nparticipant \&quot;Backend (ICoFR Service)\&quot; as BE\ndatabase \&quot;Database\&quot; as DB\n\n== DASHBOARD ==\nUser -&gt; FE: Click \&quot;Go\&quot; (Assessment Ref No)\nFE -&gt; BE: Fetch Risks\nBE -&gt; DB: Get Risks by Assessment\nDB --&gt; BE: Risk List\nBE --&gt; FE: Response\nFE --&gt; User: Display Risks\n\n== ADD RISK ==\nUser -&gt; FE: Click \&quot;Add Risk\&quot;\nFE -&gt; BE: Request Master Data\nBE -&gt; DB: Fetch Master Data\nDB --&gt; BE: Master Data\nBE --&gt; FE: Response\nFE --&gt; User: Open Stepper\n\n====================================\n== STEP 1: RISK IDENTIFICATION ==\n====================================\nUser -&gt; FE: Enter Risk Details\nFE -&gt; BE: Submit Risk Data\nBE -&gt; DB: Save Risk\nBE --&gt; FE: Success\n\n====================================\n== STEP 2: INHERENT ASSESSMENT ==\n====================================\nUser -&gt; FE: Enter Assessment Data\nFE -&gt; BE: Submit Assessment\nBE -&gt; DB: Fetch Required Data\nBE -&gt; BE: Calculate Risk Score\nBE -&gt; DB: Save Assessment\nBE --&gt; FE: Return Heatmap\n\n====================================\n== STEP 3: CONTROL IMPLEMENTATION ==\n====================================\nUser -&gt; FE: Enter Control Details\nFE -&gt; BE: Submit Control Data\nBE -&gt; DB: Save Control\nBE -&gt; BE: Calculate Residual Risk\nBE --&gt; FE: Return Heatmap\n\n====================================\n== STEP 4: MITIGATION PLAN ==\n====================================\nUser -&gt; FE: Enter Mitigation Data\nFE -&gt; BE: Submit Plan\nBE -&gt; DB: Save Mitigation\nBE --&gt; FE: Success\n\n====================================\n== STEP 5: MONITORING &amp; REVIEW ==\n====================================\nUser -&gt; FE: Submit Review\nFE -&gt; BE: Send Review Data\nBE -&gt; DB: Save Logs / Review Data\nBE --&gt; FE: Final Success\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="hIKehaJSn5MlDgzfxqjM-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1855" width="607" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="m2AZi0bz7qJjqk6nTyii" name="RISK_ASSESSMENT_FLOW">
    <mxGraphModel dx="1144" dy="586" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nactor User\nparticipant \&quot;Frontend (UI)\&quot; as FE\nparticipant \&quot;Backend (ICoFR Service)\&quot; as BE\ndatabase \&quot;Database\&quot; as DB\n\n== DASHBOARD ==\nUser -&gt; FE: Click \&quot;Go\&quot; (Assessment Reference No)\nFE -&gt; BE: Fetch Risks for Assessment\nBE -&gt; DB: Get Risks by Assessment Ref\nDB --&gt; BE: Risk List\nBE --&gt; FE: Risk Data\nFE --&gt; User: Display Risks List\n\n== ADD NEW RISK (ROLE CHECK) ==\nUser -&gt; FE: Click \&quot;Add Risk\&quot;\nFE -&gt; BE: Check User Role\n\nBE -&gt; DB: Fetch User Role\nDB --&gt; BE: Role\nBE --&gt; FE: Role Response\n\nalt User is NOT CRO/Admin\n    FE --&gt; User: Show Notification\\n\&quot;Only CRO/Admin can add risk\&quot;\nelse User is CRO/Admin\n    FE -&gt; BE: Request Master Data\n    BE -&gt; DB: Fetch Master Data\n    DB --&gt; BE: Master Data\n    BE --&gt; FE: Master Data Response\n\n    FE --&gt; User: Open Modal (Stepper Form)\n\n    ====================================\n    == STEP 1: RISK IDENTIFICATION ==\n    ====================================\n    User -&gt; FE: Fill Risk Details\n    FE -&gt; BE: Submit Risk Identification\n\n    note right of FE\n    Fields:\n    - Risk Title (M)\n    - Risk Description\n    - Risk Category (M)\n    - Risk Type (M)\n    - Business Process\n    - Department (M)\n    - Start Date\n    - End Date\n    end note\n\n    BE -&gt; DB: Save Risk Data\n    BE --&gt; FE: Success\n\n    ====================================\n    == STEP 2: INHERENT RISK ASSESSMENT ==\n    ====================================\n    User -&gt; FE: Fill Assessment Details\n    FE -&gt; BE: Submit Assessment Data\n\n    note right of FE\n    Fields:\n    - Likelihood\n    - Impact Category (M)\n    - Current Cycle\n    - Root Cause (M)\n    - Inherent Impact\n    - Risk Casual Factor\n    - Impact Description\n    end note\n\n    BE -&gt; DB: Fetch Required Data\n    BE -&gt; BE: Calculate Inherent Risk Score\n    BE -&gt; DB: Save Assessment\n    BE --&gt; FE: Return Heatmap\n\n    ====================================\n    == STEP 3: CONTROL IMPLEMENTATION ==\n    ====================================\n    User -&gt; FE: Fill Control Details\n    FE -&gt; BE: Submit Control Data\n\n    note right of FE\n    Fields:\n    - Root Cause (from Step 2)\n    - Control (M)\n    - Control Owner\n    - Control Frequency\n    - Control Classification (M)\n    - Control Type (M)\n    - Mitigation Type (M)\n    - Control Category (M)\n    end note\n\n    BE -&gt; DB: Save Control Mapping\n    BE -&gt; BE: Calculate Residual Risk\n    BE --&gt; FE: Return Residual Heatmap\n\n    ====================================\n    == STEP 4: MITIGATION ACTION PLAN ==\n    ====================================\n    User -&gt; FE: Fill Mitigation Details\n    FE -&gt; BE: Submit Mitigation Plan\n\n    note right of FE\n    Fields:\n    - Action Description\n    - Mitigation Owner\n    - Target Date\n    - Extension Request\n    - Implementation Status\n    end note\n\n    BE -&gt; DB: Save Mitigation Plan\n    BE --&gt; FE: Success\n\n    ====================================\n    == STEP 5: MONITORING &amp; REVIEW ==\n    ====================================\n    User -&gt; FE: Perform Review Actions\n    FE -&gt; BE: Submit Review Data\n\n    note right of FE\n    Fields:\n    - TOC (Test of Controls)\n    - SoD Violation Monitoring\n    - Risk Assessment Review\n    - Risk Owner Review\n    end note\n\n    BE -&gt; DB: Save Audit Logs\n    BE --&gt; FE: Final Submission Success\nend\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="KX5e22ouD--Xg9mRf4n--1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="2667" width="748" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
